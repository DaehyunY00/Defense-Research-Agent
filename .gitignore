# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Build and packaging outputs
build/
dist/
*.egg-info/

# Local environment and secrets
.env
.env.*
!.env.example

# Generated application artifacts
artifacts/*
!artifacts/.gitkeep

# Terraform local state and operator values
**/.terraform/
*.tfstate
*.tfstate.*
deploy/gcp-sandbox/terraform.tfvars
deploy/gcp-app/terraform.tfvars

# Test and coverage outputs
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp
