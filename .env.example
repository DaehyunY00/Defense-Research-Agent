# Local paths. Keep data read-only; write generated outputs only to artifacts.
DEFENSE_RESEARCH_DATA_DIR=data
DEFENSE_RESEARCH_ARTIFACTS_DIR=artifacts

# Application logging.
DEFENSE_RESEARCH_LOG_LEVEL=INFO

# Claude API. In GCP, map this exact variable from Secret Manager. It is the
# only required value for the default seven-role model routing.
ANTHROPIC_API_KEY=

# Optional Claude operational overrides. Defaults are deployable as-is.
DEFENSE_RESEARCH_CLAUDE_TIMEOUT_SECONDS=90
DEFENSE_RESEARCH_CLAUDE_MAX_RETRIES=2

# GCP 배포에서는 deploy/gcp-app/deploy.sh가 아래 비밀이 아닌 값을 주입한다.
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# DEFENSE_RESEARCH_GCP_REGION=asia-northeast3
# DEFENSE_RESEARCH_JOB_NAME=defense-research-worker
# DEFENSE_RESEARCH_ARTIFACT_BUCKET=your-result-bucket
# DEFENSE_RESEARCH_FIRESTORE_DATABASE=(default)
# DEFENSE_RESEARCH_CORPUS_BUCKET=your-private-corpus-bucket
# DEFENSE_RESEARCH_CORPUS_MANIFEST_OBJECT=corpus/manifests/<sha256>.json
# DEFENSE_RESEARCH_CORPUS_MAX_BYTES=104857600

# Claude server-side web search uses the same ANTHROPIC_API_KEY. No second
# search credential is needed. Values are bare DNS names, not URLs.
DEFENSE_RESEARCH_OFFICIAL_SOURCE_DOMAINS=assembly.go.kr,congress.gov,crsreports.congress.gov,dapa.go.kr,defense.gov,gao.gov,kida.re.kr,law.go.kr,mnd.go.kr,nato.int,state.gov,un.org
DEFENSE_RESEARCH_OFFICIAL_SEARCH_MAX_USES=4

# Optional per-role model overrides. Uncomment only after evaluating a route.
# DEFENSE_RESEARCH_CLAUDE_MODEL_MAIN_RESEARCHER=claude-opus-5
# DEFENSE_RESEARCH_CLAUDE_MODEL_LITERATURE_RESEARCHER=claude-haiku-4-5
# DEFENSE_RESEARCH_CLAUDE_MODEL_CURRENT_ISSUE_RESEARCHER=claude-haiku-4-5
# DEFENSE_RESEARCH_CLAUDE_MODEL_METHODOLOGY_RESEARCHER=claude-sonnet-5
# DEFENSE_RESEARCH_CLAUDE_MODEL_DEVELOPER_RESEARCHER=claude-sonnet-5
# DEFENSE_RESEARCH_CLAUDE_MODEL_EVIDENCE_AUDITOR=claude-opus-5
# DEFENSE_RESEARCH_CLAUDE_MODEL_CRITICAL_REVIEWER=claude-opus-5

# Local/offline external issue provider fixture.
DEFENSE_RESEARCH_EXTERNAL_ISSUE_PROVIDER=mock
DEFENSE_RESEARCH_EXTERNAL_ISSUE_FIXTURE=tests/fixtures/external_issues.json

# Reserved adapter boundary for non-Claude providers. The default GCP worker does
# not read these values.
DEFENSE_RESEARCH_EXTERNAL_SEARCH_BASE_URL=
DEFENSE_RESEARCH_EXTERNAL_SEARCH_API_KEY=
DEFENSE_RESEARCH_EXTERNAL_SEARCH_TIMEOUT_SECONDS=10
